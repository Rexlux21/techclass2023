 State: The Component's Memory
    
This is where the magic happens. State is data that changes over time (like a counter, a text input, or a loading spinner). When state changes, React "re-renders" (updates) the screen automatically.
We use a "Hook" called useState for this.
Let’s try a "Hello World" Exercise
Copy and paste this into your editor (or just read through it). It combines everything above:
javascript
import { useState } from 'react';

function Counter() {
  // 1. Setup State: 'count' is the value, 'setCount' is the function to change it
  const [count, setCount] = useState(0);

  function handleClick() {
    setCount(count + 1); // 2. Update the state
  }

  return (
    <div>
      <p>You clicked {count} times</p>
      {/* 3. Trigger the change on click */}
      <button onClick={handleClick}>Click me!</button>
    </div>
  );
}

    import { useState } from 'react';

function TaskApp() {
  const [task, setTask] = useState(""); // For the input box
  const [list, setList] = useState([]); // For the array of tasks

  function addTask() {
    if (task !== "") {
      setList([...list, task]); // Add new task to the array
      setTask(""); // Clear the input box
    }
  }

  return (
    <div style={{ padding: '20px' }}>
      <h2>My Tasks</h2>
      
      {/* 1. Controlled Input: It stays in sync with state */}
      <input 
        value={task} 
        onChange={(e) => setTask(e.target.value)} 
        placeholder="Enter a task..."
      />
      <button onClick={addTask}>Add</button>

      {/* 2. Rendering a List */}
      <ul>
        {list.map((item, index) => (
          <li key={index}>{item}</li>
        ))}
      </ul>
    </div>
  );
}
