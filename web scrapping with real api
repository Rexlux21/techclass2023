import React, { useState, useEffect } from 'react';

export default function App() {
  const [images, setImages] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  
  // Manage search parameters dynamically
  const [zipCode, setZipCode] = useState('33321');

  const fetchRealEstateImages = async (e) => {
    if (e) e.preventDefault();
    
    setLoading(true);
    setError(null);

    // Build the query string using the correct HasData format
    const API_URL = 'https://api.hasdata.com/scrape/google/serp';
    const API_KEY = ''; // Replace this
    
    // Construct the search phrase dynamically
    const searchQuery = `${zipCode} real estate listings houses for sale`;

    const queryParams = new URLSearchParams({
      q: searchQuery,
      tbm: 'isch' // Tells Google to return Image Search Results
    });

    try {
      const response = await fetch(`${API_URL}?${queryParams}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': API_KEY
        }
      });

      if (!response.ok) {
        throw new Error(`Scraper Error: ${response.status} - ${response.statusText}`);
      }

      const data = await response.json();
      
      // Target the images payload array from HasData's structural output
      setImages(data.imagesResults || []);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchRealEstateImages();
  }, []);

  return (
    <div style={styles.container}>
      <header style={styles.header}>
        <h1>📸 HasData SERP Real Estate Images</h1>
      </header>

      {/* Input Field Form */}
      <form onSubmit={fetchRealEstateImages} style={styles.form}>
        <div style={styles.inputGroup}>
          <label style={styles.label}>Target Zip Code</label>
          <input 
            type="text" 
            value={zipCode} 
            onChange={(e) => setZipCode(e.target.value)} 
            style={styles.input}
            placeholder="e.g. 33321"
            required
          />
        </div>
        <button type="submit" disabled={loading} style={styles.button}>
          {loading ? 'Scraping Google...' : 'Scrape Images'}
        </button>
      </form>

      {/* States UI */}
      {loading && <div style={styles.message}>⏳ Fetching active image components from Google...</div>}
      {error && <div style={{...styles.message, color: 'red'}}>❌ Scraper Error: {error}</div>}
      {!loading && !error && images.length === 0 && (
        <div style={styles.message}>No images retrieved. Verify your API Key permissions.</div>
      )}

      {/* Image Output Masonry Grid */}
      <div style={styles.grid}>
        {images.map((img, index) => (
          <div key={index} style={styles.card}>
            <div style={styles.imageContainer}>
              <img 
                src={img.originalUrl || img.thumbnailUrl} 
                alt={img.title} 
                style={styles.image}
                loading="lazy"
                onError={(e) => { e.target.src = img.thumbnailUrl || 'https://placehold.co'; }}
              />
            </div>
            <div style={styles.cardContent}>
              <h3 style={styles.title}>{img.title || "Real Estate Listing Photo"}</h3>
              <a href={img.originalUrl} target="_blank" rel="noreferrer" style={styles.sourceLink}>
                Source: {img.source || "View Original"}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

const styles = {
  container: { maxWidth: '1200px', margin: '0 auto', padding: '20px', fontFamily: 'sans-serif' },
  header: { textAlign: 'center', marginBottom: '20px' },
  form: { display: 'flex', gap: '10px', background: '#f5f5f5', padding: '15px', borderRadius: '6px', marginBottom: '20px', alignItems: 'flex-end' },
  inputGroup: { display: 'flex', flexDirection: 'column', gap: '5px', flexGrow: 1 },
  label: { fontSize: '12px', fontWeight: 'bold' },
  input: { padding: '10px', borderRadius: '4px', border: '1px solid #ccc' },
  button: { padding: '10px 20px', backgroundColor: '#22c55e', color: '#fff', border: 'none', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold' },
  message: { textAlign: 'center', margin: '20px 0' },
  grid: { display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(250px, 1fr))', gap: '20px' },
  card: { border: '1px solid #eee', borderRadius: '6px', overflow: 'hidden', display: 'flex', flexDirection: 'column' },
  imageContainer: { width: '100%', height: '180px', background: '#fafafa' },
  image: { width: '100%', height: '100%', objectFit: 'cover' },
  cardContent: { padding: '10px', flexGrow: 1, display: 'flex', flexDirection: 'column', justify: 'space-between' },
  title: { fontSize: '14px', margin: '0 0 5px 0', color: '#333', lineClamp: 2, display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden' },
  sourceLink: { fontSize: '12px', color: '#3b82f6', textDecoration: 'none', fontWeight: 'bold' }
};
